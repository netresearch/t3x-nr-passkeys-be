{
    "name": "netresearch/nr-passkeys-be",
    "description": "Passwordless TYPO3 backend authentication via Passkeys (WebAuthn/FIDO2) - by Netresearch",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "passkeys",
        "webauthn",
        "fido2",
        "passwordless",
        "authentication",
        "backend"
    ],
    "authors": [
        {
            "name": "Netresearch DTT GmbH",
            "homepage": "https://www.netresearch.de/",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/netresearch/t3x-nr-passkeys-be",
    "support": {
        "issues": "https://github.com/netresearch/t3x-nr-passkeys-be/issues",
        "source": "https://github.com/netresearch/t3x-nr-passkeys-be"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-setup": "^12.4 || ^13.4 || ^14.3",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "netresearch/typo3-ci-workflows": "^1.4",
        "ergebnis/phpstan-rules": "^2.6",
        "dg/bypass-finals": "^1.9",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.68",
        "typo3/testing-framework": "^8.2 || ^9.0",
        "typo3/cms-dashboard": "^12.4 || ^13.4 || ^14.3",
        "phpat/phpat": "^0.12"
    },
    "suggest": {
        "typo3/cms-dashboard": "Adds passkey adoption and credential-count widgets to the TYPO3 dashboard"
    },
    "autoload": {
        "psr-4": {
            "Netresearch\\NrPasskeysBe\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netresearch\\NrPasskeysBe\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "a9f/fractor-extension-installer": true,
            "captainhook/hook-installer": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "bin-dir": ".Build/bin",
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "nr_passkeys_be",
            "web-dir": ".Build/Web"
        },
        "captainhook": {
            "config": "Build/captainhook.json"
        }
    },
    "scripts": {
        "ci:cgl": "php-cs-fixer fix --config Build/.php-cs-fixer.php",
        "ci:mutation": "infection --configuration=Build/infection.json5 --threads=max",
        "ci:rector": "rector process --config Build/rector.php",
        "ci:test:php:all": [
            "@ci:test:php:cgl",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:unit",
            "@ci:test:php:fuzz",
            "@ci:test:php:functional"
        ],
        "ci:check": [
            "@ci:test:php:cgl",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:unit",
            "@ci:test:php:fuzz"
        ],
        "ci:test:php:cgl": "php-cs-fixer fix --config Build/.php-cs-fixer.php --dry-run --diff",
        "ci:test:php:functional": "phpunit -c Build/phpunit.functional.xml",
        "ci:test:php:fuzz": "phpunit -c Build/phpunit.xml --testsuite fuzz",
        "ci:test:php:phpstan": "phpstan analyse -c Build/phpstan.neon",
        "ci:test:php:rector": "rector process --config Build/rector.php --dry-run",
        "ci:test:php:unit": "phpunit -c Build/phpunit.xml --testsuite unit"
    }
}
