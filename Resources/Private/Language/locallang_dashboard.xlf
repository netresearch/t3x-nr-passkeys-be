<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="messages">
        <body>
            <trans-unit id="widget_group.nrpasskeys">
                <source>Passkeys</source>
            </trans-unit>

            <trans-unit id="widget.adoption.title">
                <source>Passkey adoption (backend &amp; frontend)</source>
            </trans-unit>
            <trans-unit id="widget.adoption.description">
                <source>Segmented doughnut of passkey adoption: an inner ring for backend users and, when the frontend passkeys extension is installed, an outer ring for frontend users. Each ring compares users with at least one active passkey against those without. Populations are shown separately, never combined.</source>
            </trans-unit>

            <!-- Per-audience segment labels (Chart.js dataset labels / tooltips) -->
            <trans-unit id="widget.adoption.segment.backend">
                <source>Backend users</source>
            </trans-unit>
            <trans-unit id="widget.adoption.segment.frontend">
                <source>Frontend users</source>
            </trans-unit>

            <trans-unit id="widget.adoption.label.with_passkeys">
                <source>With passkeys</source>
            </trans-unit>
            <trans-unit id="widget.adoption.label.without_passkeys">
                <source>Without passkeys</source>
            </trans-unit>

            <trans-unit id="widget.credentials.title">
                <source>Active passkeys (all audiences)</source>
            </trans-unit>
            <trans-unit id="widget.credentials.subtitle">
                <source>Backend + frontend, not revoked</source>
            </trans-unit>
            <trans-unit id="widget.credentials.description">
                <source>Total active (not revoked) passkey credentials across backend users and, when installed, frontend users.</source>
            </trans-unit>
        </body>
    </file>
</xliff>
