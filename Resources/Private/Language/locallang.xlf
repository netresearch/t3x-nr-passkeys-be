                <source>Passkeys</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.description" resname="admin.passkeys.description">
                <source>WebAuthn/FIDO2 passkeys registered for this user. Admins can revoke individual passkeys or unlock rate-limited accounts.</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.enabled" resname="admin.passkeys.enabled">
                <source>Enabled</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.disabled" resname="admin.passkeys.disabled">
                <source>No passkeys</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.revoke" resname="admin.passkeys.revoke">
                <source>Revoke</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.revokeAll" resname="admin.passkeys.revokeAll">
                <source>Revoke all passkeys</source>
            </trans-unit>
