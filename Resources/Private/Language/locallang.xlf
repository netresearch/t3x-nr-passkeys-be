            </trans-unit>
            <trans-unit id="admin.passkeys.revoke.confirm.title" resname="admin.passkeys.revoke.confirm.title">
                <source>Revoke passkey</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.revoke.confirm.text" resname="admin.passkeys.revoke.confirm.text">
                <source>Are you sure you want to revoke this passkey?</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.unlock" resname="admin.passkeys.unlock">
                <source>Unlock account</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.unlock.confirm.title" resname="admin.passkeys.unlock.confirm.title">
                <source>Unlock account</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.unlock.confirm.text" resname="admin.passkeys.unlock.confirm.text">
                <source>Reset the rate limiter for this user?</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.status.active" resname="admin.passkeys.status.active">
                <source>Active</source>
            </trans-unit>
            <trans-unit id="admin.passkeys.status.revoked" resname="admin.passkeys.status.revoked">
