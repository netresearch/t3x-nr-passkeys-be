{
    "canonical": true,
    "printWidth": 120,
    "exclude": [
        "ext_emconf.php",
        ".Build",
        ".printer",
        "vendor",
        "node_modules",
        "var",
        "Documentation-GENERATED-temp"
    ],
    "formatter": [
        "php",
        ".Build/bin/php-cs-fixer",
        "fix",
        "--config=Build/.php-cs-fixer.php",
        "--path-mode=intersection",
        "{files}"
    ],
    "verify": [
        {
            "scope": "project",
            "command": [
                "php",
                ".Build/bin/phpstan",
                "analyse",
                "--configuration=Build/phpstan.neon",
                "--no-progress",
                "--memory-limit=1G"
            ]
        }
    ]
}
